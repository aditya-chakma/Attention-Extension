{
    "name": "Attention",
    "version": "1.2.0",
    "description": "Multi feature Extention to improve your work",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*", "https://*.facebook.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*", "https://*.facebook.com/*"],
            "js": ["icons.js", "bookmarkStore.js", "contentScript.js"],
            "css": ["hide.css", "player-buttons.css"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "blocked.html"
            ],
            "matches": ["https://*.youtube.com/*", "https://*.facebook.com/*"]
        }
    ],
    "action": {
        "default_icon": {
            "16": "assets/ext-icon.png",
            "24": "assets/ext-icon.png",
            "32": "assets/ext-icon.png"
        },
        "default_title": "Attention",
        "default_popup": "popup.html"
    },
    "manifest_version": 3
}
